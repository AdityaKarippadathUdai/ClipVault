{
  "name": "clipvault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist-electron/main.js",
  "description": "ClipVault desktop clipboard manager",
  "author": {
    "name": "ClipVault",
    "email": "team@clipvault.app"
  },
  "homepage": "https://example.com",
  "scripts": {
    "start": "npm run electron",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/build-electron.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron": "electron ./electron/main.cjs",
    "electron:dev": "concurrently \"vite\" \"electron ./electron/main.cjs\",",
    "electron:build": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:mac": "npm run build && electron-builder --mac",
    "package": "npm run electron:build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "dotenv": "^17.2.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.clipvault.desktop",
    "productName": "ClipVault",
    "copyright": "Copyright © 2026 ClipVault",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "dist-electron/main.js",
      "dist-electron/preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "icon": "build/icons/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": ["portable", "nsis"],
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
